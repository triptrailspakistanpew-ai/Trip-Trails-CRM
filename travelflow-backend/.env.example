NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000,

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://username:password@localhost:5432/travelflow?schema=public
DIRECT_URL=postgresql://username:password@localhost:5432/travelflow?schema=public

DB_HOST=localhost
DB_NAME=travelflow
DB_USER=username
DB_PASSWORD=password
DB_PORT=5432

JWT_SECRET=your-jwt-secret-key-at-least-64-characters-long
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
CRON_SECRET=your-secret
